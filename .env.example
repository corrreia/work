# Copy to ~/.config/work/env (./work.sh setup does this for you).
# Run ./work.sh paths to see where everything lives.

# --- Local guest accounts (Windows VM + Linux container) ---
# Shared by both guests and separate from the VPN password, so rotating the VPN
# credential never touches it. Not domain-joined, so it does not rotate.
# ./work.sh setup generates a random one; set it by hand only on this manual path.
USERNAME=your.username
VM_PASSWORD=changeme

# --- Corporate VPN ---
# Separate from VM_PASSWORD on purpose: this one rotates on the company
# schedule (~every 45 days). 2FA is prompted for at connect time.
VPN_SERVER=vpn.example.com
VPN_PASSWORD=

# Internal DNS server, reachable only through the tunnel. Both guests use it
# for all lookups while the VPN is up.
CORPORATE_DNS=

# Public ranges to route through the tunnel as well, comma-separated. "github"
# expands at connect time to GitHub's current ranges (api.github.com/meta),
# since corporate GitHub is IP-allowlisted to company egress and git is blocked
# otherwise. A fixed list goes stale: GitHub keeps adding regional addresses.
# Add any other public range your company only allows from its own egress.
VPN_EXTRA_ROUTES=github

# Optional: an internal-only hostname for ./work.sh test
VPN_TEST_HOST=

# --- Windows silent login (optional) ---
# ./work.sh windows sync (run on every Windows start) stores your AD credential
# in Windows Credential Manager and allows Edge + Chrome to log in silently to
# SSO_SITES. Leave AD_DOMAIN empty to skip it.
AD_DOMAIN=
# Comma-separated host patterns. Default: *.AD_DOMAIN
SSO_SITES=
# Default: USERNAME@AD_DOMAIN
AD_USER=
# Default: VPN_PASSWORD
AD_PASSWORD=
